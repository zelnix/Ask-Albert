# Variable-name template only. Do NOT add real credentials here or commit any .env file.
# Set values in the deployment platform's environment-variable settings for BOTH
# the Next.js build (NEXT_PUBLIC_* variables) and runtime (backend variables).
# Local /app/.env remains untracked. See backend/config.py for optional defaults.

# Required: MongoDB connection + database used by the existing application.
MONGO_URL=
DB_NAME=

# App's public origin (used by links and server configuration).
NEXT_PUBLIC_BASE_URL=

# Existing Google sign-in. The public client ID must be present at build time.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
AUTH_EMAIL_ALLOWLIST=

# Existing AI features (set the keys for the features currently in use).
EMERGENT_LLM_KEY=
GEMINI_API_KEY=

# Existing admin and notification settings (where enabled).
ADMIN_PASSCODE=
RESEND_API_KEY=
RESEND_FROM=
UNSUB_SECRET=

# Optional data providers: configure only those already enabled for your account.
COINGLASS_API_KEY=
FRED_API_KEY=
GLASSNODE_API_KEY=
